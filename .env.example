# Copy to .env and adjust as needed.

# Qdrant connection
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Collection all books share
BOOK_COLLECTION=books

# Models (FastEmbed, runs on CPU)
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
# Optional cross-encoder reranker (used only with --rerank / rerank=True)
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Chunking (characters, approximate)
CHUNK_SIZE=1800
CHUNK_OVERLAP=200

# Per-repo defaults for the MCP server (optional, comma-separated)
# DEFAULT_BOOKS=
# DEFAULT_TAGS=
